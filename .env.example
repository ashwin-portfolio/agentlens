# Copy to .env and fill in. Never commit .env (already gitignored).

# Postgres from docker-compose.yml (host port 5433 → container 5432).
# The +psycopg driver suffix selects psycopg 3, which the server depends on.
DATABASE_URL=postgresql+psycopg://agentlens:agentlens@localhost:5433/agentlens

# Redis from docker-compose.yml.
REDIS_URL=redis://localhost:6379/0

# LLM providers: Anthropic for the judge + demo agents, Groq for the FitTrack demo.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
